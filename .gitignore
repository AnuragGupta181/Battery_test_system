# --- LabVIEW per-user / per-machine files ---
*.aliases
*.lvlps
*.lvbitx.tmp
# Compiled object cache and temp files
*.lvobj
*.vi.bak
*.ctl.bak
*.lvproj.bak
# LabVIEW auto-save / recovery
LVAutoSave/
# Build output of LabVIEW build specifications (exe, rtexe, installers)
builds/
*.exe
*.rtexe

# --- Generated by this project's tooling ---
# staging copies, layout experiments and backups of replaced VIs (regenerable / local only)
Build/Tools_LV2019/staging/
Build/Tools_LV2019/screens/
# test outputs (logs, CSV files written by test runs)
Build/Tools_LV2019/tests/out/
# composed helper VIs can be regenerated from their .xml sources
Build/Tools_LV2019/*.vi
Build/Tools_LV2019/carriers/*.vi

# --- Editor / agent / OS ---
.claude/settings.local.json
.vs/
.vscode/
Thumbs.db
desktop.ini
*.tmp
~$*
